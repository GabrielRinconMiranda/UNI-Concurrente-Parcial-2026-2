# Dockerfile para Servidor Orquestador Java en Render
FROM eclipse-temurin:17-jdk-alpine AS builder

WORKDIR /app
COPY java_server_orchestrator /app/java_server_orchestrator
COPY dataset /app/dataset
COPY web /app/web

RUN cd /app/java_server_orchestrator && \
    mkdir -p bin && \
    javac -d bin $(find src -name "*.java")

FROM eclipse-temurin:17-jre-alpine
WORKDIR /app
COPY --from=builder /app/java_server_orchestrator/bin /app/bin
COPY --from=builder /app/dataset /app/dataset
COPY --from=builder /app/web /app/web

ENV PORT=8080
EXPOSE 8080 9010 8085

CMD ["sh", "-c", "java -cp bin server.ServerOrchestrator 9010 8085 ${PORT:-8080}"]

